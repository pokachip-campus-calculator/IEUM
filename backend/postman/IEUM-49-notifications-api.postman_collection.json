              "pm.test('쪽지 내용·낱말이 알림에 없다', () => pm.expect(JSON.stringify(j.items)).to.not.include('비밀쪽지내용').and.not.include('죽고 싶다'));",
              "pm.test('학습자: NOTE_READ \"이음쌤이 쪽지를 읽었어요\"', () => { const it = j.items.find(i => i.type === 'NOTE_READ'); pm.expect(it, 'NOTE_READ 없음').to.exist; pm.expect(it.title).to.eql('이음쌤이 쪽지를 읽었어요'); });",
              "pm.test('학습자: REPLY_ARRIVED \"이음쌤의 답장이 도착했어요\"', () => { const it = j.items.find(i => i.type === 'REPLY_ARRIVED'); pm.expect(it, 'REPLY_ARRIVED 없음').to.exist; pm.expect(it.title).to.eql('이음쌤의 답장이 도착했어요'); });",
              "pm.test('학습자에게 SIGNAL_FLAGGED은 없다', () => pm.expect(j.items.some(i => i.type === 'SIGNAL_FLAGGED')).to.eql(false));",
              "pm.test('NOTE_READ는 이 쪽지에 1건', () => pm.expect(j.items.filter(i => i.type === 'NOTE_READ' && i.linkId === Number(pm.collectionVariables.get('threadId'))).length).to.eql(1));",
