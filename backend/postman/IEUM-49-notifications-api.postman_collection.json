    {
      "name": "22-A 학습자 알림: TEACHER_ASSIGNED가 있고 SIGNAL_FLAGGED는 없다",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('{ unreadCount, items } 형식', () => { pm.expect(j.unreadCount).to.be.a('number'); pm.expect(j.items).to.be.an('array'); });",
              "pm.test('createdAt에 +09:00', () => j.items.forEach(i => pm.expect(i.createdAt).to.match(/\\+09:00$/)));",
              "pm.test('최대 50건', () => pm.expect(j.items.length).to.be.at.most(50));",
              "pm.test('쪽지 내용·낱말이 알림에 없다', () => pm.expect(JSON.stringify(j.items)).to.not.include('비밀쪽지내용').and.not.include('죽고 싶다'));",
              "pm.test('학습자: TEACHER_ASSIGNED \"담당 이음쌤이 정해졌어요\"', () => { const it = j.items.find(i => i.type === 'TEACHER_ASSIGNED'); pm.expect(it, 'TEACHER_ASSIGNED 없음').to.exist; pm.expect(it.title).to.eql('담당 이음쌤이 정해졌어요'); });",
              "pm.test('학습자에게 SIGNAL_FLAGGED은 없다', () => pm.expect(j.items.some(i => i.type === 'SIGNAL_FLAGGED')).to.eql(false));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ],
        "url": "{{baseUrl}}/notifications"
      }
    },
    {
      "name": "22-B 이음쌤 알림: LEARNER_ASSIGNED·NOTE_RECEIVED·SIGNAL_FLAGGED (제목 고정 문구, 링크 확인)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('{ unreadCount, items } 형식', () => { pm.expect(j.unreadCount).to.be.a('number'); pm.expect(j.items).to.be.an('array'); });",
              "pm.test('createdAt에 +09:00', () => j.items.forEach(i => pm.expect(i.createdAt).to.match(/\\+09:00$/)));",
              "pm.test('최대 50건', () => pm.expect(j.items.length).to.be.at.most(50));",
              "pm.test('쪽지 내용·낱말이 알림에 없다', () => pm.expect(JSON.stringify(j.items)).to.not.include('비밀쪽지내용').and.not.include('죽고 싶다'));",
              "pm.test('이음쌤: LEARNER_ASSIGNED \"새 학습자가 배정됐어요\"', () => { const it = j.items.find(i => i.type === 'LEARNER_ASSIGNED'); pm.expect(it, 'LEARNER_ASSIGNED 없음').to.exist; pm.expect(it.title).to.eql('새 학습자가 배정됐어요'); });",
              "pm.test('이음쌤: NOTE_RECEIVED \"새 쪽지가 도착했어요\"', () => { const it = j.items.find(i => i.type === 'NOTE_RECEIVED'); pm.expect(it, 'NOTE_RECEIVED 없음').to.exist; pm.expect(it.title).to.eql('새 쪽지가 도착했어요'); });",
              "pm.test('이음쌤: SIGNAL_FLAGGED \"확인이 필요한 쪽지가 있어요\"', () => { const it = j.items.find(i => i.type === 'SIGNAL_FLAGGED'); pm.expect(it, 'SIGNAL_FLAGGED 없음').to.exist; pm.expect(it.title).to.eql('확인이 필요한 쪽지가 있어요'); });",
              "pm.test('링크: NOTE_RECEIVED=THREAD(쪽지), SIGNAL_FLAGGED=SIGNAL, LEARNER_ASSIGNED=STUDENT', () => { const by = t => j.items.find(i => i.type === t); pm.expect(by('NOTE_RECEIVED').linkType).to.eql('THREAD'); pm.expect(by('NOTE_RECEIVED').linkId).to.eql(Number(pm.collectionVariables.get('threadId'))); pm.expect(by('SIGNAL_FLAGGED').linkType).to.eql('SIGNAL'); pm.expect(by('LEARNER_ASSIGNED').linkType).to.eql('STUDENT'); });"
            ]
          }
        }
      ],
