              "pm.test('{ unreadCount, items } 형식', () => { pm.expect(j.unreadCount).to.be.a('number'); pm.expect(j.items).to.be.an('array'); });",
              "pm.test('createdAt에 +09:00', () => j.items.forEach(i => pm.expect(i.createdAt).to.match(/\\+09:00$/)));",
              "pm.test('최대 50건', () => pm.expect(j.items.length).to.be.at.most(50));",
              "pm.test('쪽지 내용·낱말이 알림에 없다', () => pm.expect(JSON.stringify(j.items)).to.not.include('비밀쪽지내용').and.not.include('죽고 싶다'));",
              "pm.test('unreadCount=0', () => pm.expect(j.unreadCount).to.eql(0));"
            ]
