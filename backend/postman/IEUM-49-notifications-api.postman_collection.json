            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('{ unreadCount, items } 형식', () => { pm.expect(j.unreadCount).to.be.a('number'); pm.expect(j.items).to.be.an('array'); });",
              "pm.test('createdAt에 +09:00', () => j.items.forEach(i => pm.expect(i.createdAt).to.match(/\\+09:00$/)));",
