              "pm.test('inProgress 최대 2개, recent 최대 3개', () => { pm.expect(b.inProgress.length).to.be.at.most(2); pm.expect(b.recent.length).to.be.at.most(3); });",
              "pm.test('resume은 기준서 모양 또는 null', () => { if (b.resume) pm.expect(b.resume).to.have.keys('practiceId','title','type','area','level','estMinutes','myStatus'); });",
