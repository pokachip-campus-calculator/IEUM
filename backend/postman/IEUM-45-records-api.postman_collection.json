              "pm.test('모두 IN_PROGRESS', () => b.items.forEach(i => pm.expect(i.status).to.eql('IN_PROGRESS')));",
              "pm.test('목록 길이 = inProgressCount', () => pm.expect(b.items.length).to.eql(b.inProgressCount));",
              "pm.test('개수는 필터와 무관', () => pm.expect(String(b.doneCount)).to.eql(pm.collectionVariables.get('doneCount')));"
            ]
          }
        }
