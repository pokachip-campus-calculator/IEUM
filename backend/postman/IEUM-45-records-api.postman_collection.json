            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "const u = b.items.find(i => i.practiceId === 1);",
              "pm.test('IN_PROGRESS', () => pm.expect(u.status).to.eql('IN_PROGRESS'));",
              "pm.test('완료한 적 있어 completedAt 유지', () => pm.expect(u.completedAt).to.match(/[+]09:00$/));",
              "pm.test('답을 비웠으니 compare null', () => pm.expect(u.compare).to.eql(null));",
              "pm.test('inProgressCount가 1 늘고 doneCount가 1 줆', () => { pm.expect(b.inProgressCount).to.eql(Number(pm.collectionVariables.get('inProgressCount')) + 1); pm.expect(b.doneCount).to.eql(Number(pm.collectionVariables.get('doneCount')) - 1); });"
