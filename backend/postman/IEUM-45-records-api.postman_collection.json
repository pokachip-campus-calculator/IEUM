    {
      "name": "11 UNIT compare - 사전·사후 문구와 changed (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "const u = b.items.find(i => i.practiceId === 1);",
              "pm.test('문항 8개', () => pm.expect(u.compare.length).to.eql(8));",
              "pm.test('compare 필드', () => u.compare.forEach(c => pm.expect(c).to.have.keys('questionId','text','then','now','changed')));",
              "pm.test('q1은 then=잘 모르겠어요, now=보내지 않고 대화를 멈춘다, changed true', () => { const c = u.compare[0]; pm.expect(c.questionId).to.eql('q1'); pm.expect(c.then).to.eql('잘 모르겠어요'); pm.expect(c.now).to.eql('보내지 않고 대화를 멈춘다'); pm.expect(c.changed).to.eql(true); });",
              "pm.test('나머지는 changed false, 점수 필드 없음', () => u.compare.slice(1).forEach(c => { pm.expect(c.changed).to.eql(false); pm.expect(c).to.not.have.property('score'); }));"
            ]
          }
        }
      ],
