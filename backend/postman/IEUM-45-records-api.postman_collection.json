    {
      "name": "11 전체 - 개수와 목록 (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('최상위 필드', () => pm.expect(b).to.have.keys('doneCount','inProgressCount','items'));pm.test('항목 필드', () => b.items.forEach(i => pm.expect(i).to.have.keys('practiceId','title','type','area','level','status','completedAt','updatedAt','compare')));",
              "pm.collectionVariables.set('total', String(b.items.length));",
              "pm.collectionVariables.set('doneCount', String(b.doneCount));",
              "pm.collectionVariables.set('inProgressCount', String(b.inProgressCount));",
              "pm.test('개수 = 목록 길이', () => pm.expect(b.doneCount + b.inProgressCount).to.eql(b.items.length));",
              "pm.test('UNIT·EMOTION은 DONE, SCENARIO는 IN_PROGRESS', () => { const m = id => b.items.find(i => i.practiceId === id).status; pm.expect(m(1)).to.eql('DONE'); pm.expect(m(3)).to.eql('DONE'); pm.expect(m(2)).to.eql('IN_PROGRESS'); });",
              "pm.test('DONE이면 completedAt이 +09:00', () => b.items.filter(i => i.status === 'DONE').forEach(i => pm.expect(i.completedAt).to.match(/[+]09:00$/)));",
              "pm.test('IN_PROGRESS 기록의 completedAt은 null이거나 완료한 적 있는 시각(다시 하는 중)이다', () => { const c = b.items.find(i => i.practiceId === 2).completedAt; pm.expect(c === null || /\\+09:00$/.test(c)).to.eql(true); });",
              "pm.test('updatedAt은 +09:00', () => b.items.forEach(i => pm.expect(i.updatedAt).to.match(/[+]09:00$/)));",
              "pm.test('기본은 최신순(updatedAt 내림차순)', () => { for (let k = 1; k < b.items.length; k++) pm.expect(b.items[k-1].updatedAt >= b.items[k].updatedAt).to.eql(true); });"
            ]
          }
        }
