{
  "info": {
    "name": "IEUM #41 회원가입·로그인 API (01·02)",
    "description": "가입 01 POST /auth/signup, 로그인 02 POST /auth/login 시나리오.\n위에서 아래로 순서대로 실행한다. 첫 요청이 실행 ID(runId)를 만들어 아이디를 매번 새로 쓴다.\n마지막 요청은 DB에서 kid{{runId}}의 status를 ACTIVE로 바꾼 뒤 따로 실행한다 (보호자 승인 API가 아직 없음).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "password",
      "value": "password1"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 가입 - 이음쌤 (403 TEACHER_SIGNUP_CLOSED)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 실행마다 새 아이디가 되도록 실행 ID를 만든다 (이 요청을 먼저 실행해야 한다)",
              "pm.collectionVariables.set('runId', Date.now().toString(36).slice(-7));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403', () => pm.response.to.have.status(403));",
              "pm.test('code TEACHER_SIGNUP_CLOSED', () => pm.expect(pm.response.json().code).to.eql('TEACHER_SIGNUP_CLOSED'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/signup",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role\": \"TEACHER\",\n  \"loginId\": \"teacher{{runId}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"김쌤\",\n  \"nickname\": \"김 이음쌤\",\n  \"birthDate\": \"1990-05-20\",\n  \"agreeTerms\": true,\n  \"agreePrivacy\": true\n}"
        }
      }
    },
    {
      "name": "01 가입 - 학습자 만 14세 이상 (201 ACTIVE)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.test('status ACTIVE', () => pm.expect(pm.response.json().status).to.eql('ACTIVE'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/signup",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role\": \"STUDENT\",\n  \"loginId\": \"student{{runId}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"홍길동\",\n  \"nickname\": \"길동\",\n  \"birthDate\": \"2008-03-15\",\n  \"phone\": \"01012345678\",\n  \"school\": \"이음중\",\n  \"agreeTerms\": true,\n  \"agreePrivacy\": true\n}"
        }
      }
    },
