    {
      "name": "02 로그인 - 정상, 대소문자 다르게 (200, 토큰 자동 저장)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('token·expiresAt·user', () => pm.expect(b).to.have.keys('token', 'expiresAt', 'user'));",
              "pm.test('user 요약', () => pm.expect(b.user).to.have.keys('id', 'nickname', 'role'));",
              "pm.collectionVariables.set('token', b.token);"
            ]
          }
        }
