              "pm.collectionVariables.set('signalId', mine.id);",
              "pm.test('항목 모양', () => pm.expect(mine).to.have.all.keys('id', 'status', 'matchedText', 'student', 'message', 'handledAt', 'responseMemo', 'createdAt'));",
              "pm.test('OPEN이 HANDLED보다 앞', () => { const s = list.map(i => i.status); pm.expect(s.lastIndexOf('OPEN')).to.be.below(s.indexOf('HANDLED') === -1 ? 9999 : s.indexOf('HANDLED')); });"
            ]
