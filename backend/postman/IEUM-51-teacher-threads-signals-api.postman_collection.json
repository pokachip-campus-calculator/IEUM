    {
      "name": "19-A 쪽지함 (200, 방금 보낸 쪽지가 맨 위, hasSignal true, signalStatus OPEN)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const first = pm.response.json().items[0];",
              "pm.test('최신 쪽지가 맨 위', () => pm.expect(String(first.id)).to.eql(String(pm.collectionVariables.get('threadId'))));",
              "pm.test('항목 모양', () => pm.expect(first).to.have.all.keys('id', 'student', 'topic', 'status', 'lastMessageAt', 'preview', 'linkedPractice', 'hasSignal', 'signalStatus'));",
              "pm.test('학습자 정보', () => { pm.expect(first.student).to.have.all.keys('id', 'nickname'); pm.collectionVariables.set('studentId', first.student.id); });",
              "pm.test('대기 중 + 신호 있음', () => { pm.expect(first.status).to.eql('WAITING'); pm.expect(first.hasSignal).to.eql(true); pm.expect(first.signalStatus).to.eql('OPEN'); });"
            ]
          }
        }
      ],
