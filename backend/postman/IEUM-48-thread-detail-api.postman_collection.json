    {
      "name": "14-A 학습자가 상세 열기 (200, signal·my_note 키 없음)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('status=WAITING, 메시지 1개', () => { pm.expect(j.status).to.eql('WAITING'); pm.expect(j.messages.length).to.eql(1); });",
              "pm.test('학습자 응답에 signal 키가 없다', () => pm.expect(j).to.not.have.property('signal'));",
              "pm.test('my_note가 어디에도 없다', () => pm.expect(JSON.stringify(j)).to.not.include('my_note').and.not.include('myNote'));",
              "pm.test('createdAt에 +09:00', () => pm.expect(j.createdAt).to.match(/\\+09:00$/));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
