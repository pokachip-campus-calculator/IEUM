{
  "info": {
    "name": "IEUM #43 홈·연습 목록 API (07·08)",
    "description": "db/V3__seed_practices.sql 시드 3건(SAFETY·HELP·EMOTION 각 1단계)이 들어간 DB 기준. 위에서 아래로 순서대로 실행한다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "loginId", "value": "learn4321" },
    { "key": "password", "value": "password123" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "00 사전 - 학습자 가입 (이미 있으면 409여도 괜찮음)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/signup",
        "body": { "mode": "raw", "raw": "{\n  \"role\": \"STUDENT\",\n  \"loginId\": \"{{loginId}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"테스트\",\n  \"nickname\": \"테스트\",\n  \"birthDate\": \"2000-01-01\",\n  \"phone\": \"01012345678\",\n  \"email\": \"learn@example.com\",\n  \"agreeTerms\": true,\n  \"agreePrivacy\": true\n}" }
      }
    },
    {
      "name": "00 사전 - 로그인 (토큰 자동 저장)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.collectionVariables.set('token', pm.response.json().token);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"loginId\": \"{{loginId}}\",\n  \"password\": \"{{password}}\"\n}" }
      }
    },
    {
      "name": "07 홈 조회 (200)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "const b = pm.response.json();",
        "pm.test('필드', () => { pm.expect(b).to.have.keys('nickname','unreadMessages','doneTotal','resume','inProgress','areas','recent'); });",
        "pm.test('areas 3개(SAFETY·HELP·EMOTION)', () => pm.expect(b.areas.map(a => a.area)).to.eql(['SAFETY','HELP','EMOTION']));",
        "pm.test('inProgress 최대 2개, recent 최대 3개', () => { pm.expect(b.inProgress.length).to.be.at.most(2); pm.expect(b.recent.length).to.be.at.most(3); });",
        "pm.test('resume은 카드 또는 null', () => { if (b.resume) pm.expect(b.resume).to.include.keys('id','title','myStatus'); });"
      ] } }],
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/home" }
    },
    {
      "name": "07 토큰 없이 홈 조회 (401)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401', () => pm.response.to.have.status(401));"] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/home" }
    },
    {
      "name": "08 연습 목록 - 전체 (200)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "const items = pm.response.json().items;",
        "pm.test('items 배열', () => pm.expect(items).to.be.an('array'));",
        "pm.test('카드 필드, content 없음', () => items.forEach(i => { pm.expect(i).to.have.keys('id','type','area','topic','level','title','summary','estMinutes','myStatus'); }));",
        "pm.test('myStatus 값', () => items.forEach(i => pm.expect(['NONE','IN_PROGRESS','DONE']).to.include(i.myStatus)));",
        "const order = {SAFETY:0, HELP:1, EMOTION:2};",
        "pm.test('영역→단계 순', () => { for (let k = 1; k < items.length; k++) { const a = items[k-1], b = items[k]; pm.expect(order[a.area] < order[b.area] || (a.area === b.area && a.level <= b.level)).to.eql(true); } });"
      ] } }],
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/practices" }
    },
    {
      "name": "08 영역 필터 area=SAFETY (200)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.test('모두 SAFETY', () => pm.response.json().items.forEach(i => pm.expect(i.area).to.eql('SAFETY')));"
      ] } }],
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/practices?area=SAFETY" }
    },
    {
      "name": "08 단계 필터 level=1 (200)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.test('모두 level 1', () => pm.response.json().items.forEach(i => pm.expect(i.level).to.eql(1)));"
      ] } }],
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/practices?level=1" }
    },
    {
      "name": "08 검색 q=비밀 (title·summary 부분 일치, 200)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.test('1건 이상, 모두 title·summary에 포함', () => { const items = pm.response.json().items; pm.expect(items.length).to.be.above(0); items.forEach(i => pm.expect((i.title + i.summary).includes('비밀')).to.eql(true)); });"
      ] } }],
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/practices?q=%EB%B9%84%EB%B0%80", "host": ["{{baseUrl}}"], "path": ["practices"], "query": [{ "key": "q", "value": "%EB%B9%84%EB%B0%80" }] } }
    },
    {
      "name": "08 조건 조합 area+level+q, 없는 결과 (200, 빈 배열)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.test('빈 items', () => pm.expect(pm.response.json().items).to.eql([]));"
      ] } }],
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/practices?area=SAFETY&level=99&q=zzzz" }
    },
    {
      "name": "08 잘못된 area (400)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('400', () => pm.response.to.have.status(400));",
        "const b = pm.response.json();",
        "pm.test('VALIDATION_FAILED + area', () => { pm.expect(b.code).to.eql('VALIDATION_FAILED'); pm.expect(b.fieldErrors[0].field).to.eql('area'); });"
      ] } }],
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/practices?area=NOPE" }
    },
    {
      "name": "08 숫자가 아닌 level (400)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('400', () => pm.response.to.have.status(400));",
        "pm.test('level 칸 오류', () => pm.expect(pm.response.json().fieldErrors[0].field).to.eql('level'));"
      ] } }],
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/practices?level=abc" }
    },
    {
      "name": "08 토큰 없이 목록 조회 (401)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401', () => pm.response.to.have.status(401));"] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/practices" }
    }
  ]
}
