          "mode": "raw",
          "raw": "{\n  \"role\": \"STUDENT\",\n  \"loginId\": \"{{loginId}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"테스트\",\n  \"nickname\": \"테스트\",\n  \"birthDate\": \"2000-01-01\",\n  \"phone\": \"01012345678\",\n  \"email\": \"learn@example.com\",\n  \"agreeTerms\": true,\n  \"agreePrivacy\": true\n}"
