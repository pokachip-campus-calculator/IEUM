    {
      "name": "09 UNIT 상세 (200, content 질문 8·카드 5)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('필드', () => pm.expect(b).to.have.keys('id','type','area','topic','level','title','summary','estMinutes','content','record'));",
              "pm.test('UNIT content', () => { pm.expect(b.type).to.eql('UNIT'); pm.expect(b.content.questions.length).to.eql(8); pm.expect(b.content.cards.length).to.eql(5); });",
              "pm.test('record는 null 또는 기록 모양', () => { if (b.record) pm.expect(b.record).to.have.keys('status','answers','myNote','updatedAt','completedAt'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/practices/1"
